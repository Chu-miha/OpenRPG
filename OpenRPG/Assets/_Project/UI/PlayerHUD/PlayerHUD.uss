VisualElement {
}

.resource-bar {
}

.resource-bar_background {
    background-color: rgb(21, 23, 26);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.resource-bar_fill {
    background-color: rgb(181, 42, 42);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.mana-bar_fill {
    background-color: rgb(45, 140, 255);
}

.stamina-bar_fill {
    background-color: rgb(69, 201, 107);
}

.health-bar_fill {
    background-color: rgb(181, 42, 42);
}

.interaction-prompt {
    position: absolute;
    left: 35%;
    right: 35%;
    bottom: 22%;
    padding-top: 8px;
    padding-right: 16px;
    padding-bottom: 8px;
    padding-left: 16px;
    background-color: rgba(0, 0, 0, 0.41);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    width: auto;
}

.interaction-prompt_text {
    width: 100%;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-definition: resource("FlatSkin/Font/Roboto-Regular");
    -unity-font-style: bold;
    color: rgb(176, 176, 176);
}
